#include <winver.h>
#include "core/version_info.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION IMPERIVM_VERSION_NUMBER
PRODUCTVERSION IMPERIVM_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "Imperivm Resurrected"
			VALUE "FileDescription", "Imperivm Resurrected mod"
			VALUE "FileVersion", IMPERIVM_VERSION_TEXT
			VALUE "InternalName", "winmm"
			VALUE "LegalCopyright", "Copyright (C) 2026 THIONG. GPL-3.0-or-later."
			VALUE "OriginalFilename", "winmm.dll"
			VALUE "ProductName", "Imperivm Resurrected"
			VALUE "ProductVersion", IMPERIVM_VERSION_TEXT
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END

// The rank emblems of the league, baked by tools/rank-emblems/bake.js and decoded by src/ui/leaguerankart.cpp. The paths are relative to
// this file.
